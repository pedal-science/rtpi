# vip — Raspberry Pi 5, 1 GB (BCM2712), Ubuntu 26.04 resolute, aarch64. The pedal's Core host.
# Sourced by scripts, and installed on vip as /etc/rtpi/device.env, where vip-boot reads it.
# Keep this the single source of truth for device facts. Plain KEY=value or KEY="value" only:
# vip-boot parses it without a shell.
#
# vip is built from an image (pedal.project, devices/vip/make-card), not upgraded with apt:
# no flash-kernel, no piboot-try. vip-boot selects kernels, profiles and roots itself.

DEVICE_NAME=vip
SSH_HOST=vip
ARCH=arm64
DEB_ARCH=arm64

# Board identity. boardrev a04171, EEPROM 66f33f7e (2026-05-11) as received.
BOARD_MODEL="Raspberry Pi 5 Model B"
BOARD_DTB=bcm2712-rpi-5-b.dtb

# Kernels. The pedal runs Ubuntu's RT flavour, rebuilt by scripts/build/vip-ubuntu-rt.sh (NUMA
# emulation on, modules trimmed to what the board loads): the same source and config every pedal
# number was measured on, differing by that fragment alone. The rebuild is in no archive — it
# reaches the board as artefacts on the card image (pedal.project devices/vip/image.lock,
# docs/vip-kernel-image.md) — and FALLBACK_KERNEL is the stock package that devices/vip/packages
# installs: the spare slot boots it, and the installer leaves it in the root beside the rebuild.
# The rescue root runs the plain flavour, so a problem in one is never in both. numaemu2 is
# numaemu1 with the screen's drivers kept through the trim (vc4, v3d, USB HID: config/vip-keep.fragment).
PEDAL_KERNEL=7.0.0-1017-raspi-realtime-numaemu2-trimmed
FALLBACK_KERNEL=7.0.0-1017-raspi-realtime
RESCUE_KERNEL=7.0.0-1017-raspi

# The card (docs/vip-image.md in pedal.project). GPT; autoboot.txt on partition 1 picks the
# boot partition. Numbers are GPT partition numbers, as the bootloader counts them.
BOOTSEL_LABEL=BOOTSEL
PEDAL_BOOT_LABEL=PEDAL-BOOT
RESCUE_BOOT_LABEL=RESCUE-BOOT
PEDAL_BOOT_PART=2
RESCUE_BOOT_PART=3
PEDAL_ROOT_LABEL=pedal
RESCUE_ROOT_LABEL=rescue
# The pedal root's GPT partition name (a restore can't rely on a filesystem label it's replacing),
# and where the image build keeps the pedal root's image for rescue to restore from (vip-reimage).
PEDAL_ROOT_PARTLABEL=pedal
PEDAL_DATA_LABEL=pedal-data
PEDAL_IMAGE=images/pedal-root.ext4.zst
PEDAL_IMAGE_SHA=images/pedal-root.ext4.sha256
# The image before the last one received (vip-reimage receive; pedal --previous).
PEDAL_IMAGE_PREV=images/pedal-root.prev.ext4.zst
PEDAL_IMAGE_PREV_SHA=images/pedal-root.prev.ext4.sha256

# Where each root mounts the FAT partitions. vip-boot mounts them itself when they aren't.
BOOTSEL_MOUNT=/boot/bootsel
PEDAL_BOOT_MOUNT=/boot/firmware

# Kernel slots in the pedal boot partition: two fixed directories. profile.txt names the
# active one; the other holds the previous kernel, or a candidate while one is tried.
SLOTS="a b"

# Every pedal command line starts with these. net.ifnames=0 keeps wlan0 and eth0 (without it
# they are wld0 and end0, bench-results/vip-spike in pedal.project). The console goes to the
# 3-pin UART header, where the Debug Probe plugs in.
BASE_ARGS="net.ifnames=0 console=ttyAMA10,115200 console=tty1 rootfstype=ext4 rootwait fixrtc cfg80211.ieee80211_regdom=GB"
# A root that never appears reboots instead of waiting for ever (README, "The dracut lockout").
DRACUT_SAFETY_ARGS="rd.shell=0 rd.emergency=reboot rd.retry=60 rd.timeout=90"
PANIC_ARGS="panic=10"

# ---------------------------------------------------------------- profiles (boot side)
# tuned: the low-latency profile. No longer "as on piv": vip gives one core to everything but the
# DSP (2026-10-09), so 1-3 are isolated and every interrupt defaults to core 0 — including the
# audio one, which pedal-tune then moves to core 1, a render core that is never the active one.
# irqaffinity=0 and the reserved cores 1-3 must agree with pedal-tune's configuration, and
# `vip-boot set-args` is how a board that is already up is brought in line with this line.
AUDIO_TUNING_ARGS="isolcpus=managed_irq,domain,1-3 nohz_full=1-3 rcu_nocbs=1-3 irqaffinity=0 skew_tick=1"
# loose: the same root and kernel, no isolation, and the maintenance target instead of the
# engine and the tuning (pedal.project's devices/vip). For profiling on all four cores,
# bisecting a tuning problem, or heavy work on the box.
LOOSE_ARGS="systemd.unit=pedal-maint.target"

# BCM2835 watchdog hardware maximum is 15s.
WATCHDOG_MAX_SEC=15
WATCHDOG_RUNTIME_SEC=14

# ---------------------------------------------------------------- fallback
# Boots in a row that never reach pedal-guard before the initramfs sends vip to rescue.
GUARD_LIMIT=3

# Network: WiFi only where vip sits; eth0 comes up by DHCP when a cable is plugged in.
NET_IFACES="wlan0 eth0"
NET_REQUIRE=any
