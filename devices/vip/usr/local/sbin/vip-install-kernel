#!/bin/bash
# vip-install-kernel — install a built pedal kernel into a pedal root, beside the stock one.
#
# One copy of the procedure, run in two places: rtpi's deploy (scripts/deploy/vip-install-rt.sh)
# on the running pedal root, and pedal.project's image build (devices/common/image/build-image)
# inside the root it is building (docs/vip-kernel-image.md there says why the kernel is an
# artefact and not a package). It is not dpkg: the pedal kernel is a rebuild that is in no
# archive, and it lives under its own release string so the stock kernel's modules are untouched
# and the spare slot always has something to fall back to.
#
#   vip-install-kernel --artefacts DIR [--root DIR] [--no-dracut]
#
# --artefacts DIR is what rtpi's scripts/build/vip-ubuntu-rt.sh leaves in build/vip/:
#
#   kernelrelease                 the release string to install as
#   build-kind                    full | trimmed
#   trimmed-ok.txt                modules the trim deliberately drops (expected absent)
#   proc-modules                  the board's loaded modules: the coverage gate's input
#   bcm2712-rpi-5-b.dtb.sha256    the built dtb, checked against the stock one
#   boot-<rel>.tar.gz             boot/{vmlinuz,config-<rel>,System.map-<rel>} + dtb/bcm2712*.dtb
#   modules-<rel>.tar.gz          lib/modules/<rel>, stripped
#   sha256sums                    optional: verified before anything is written
#
# The artefacts directory is only ever read (the image build mounts it read-only); everything
# temporary goes to a scratch directory. --root defaults to / , the running pedal root. The caller
# provides /proc, /sys and /dev in that root (a running root has them; the image build mounts
# them). The stock release the fallback slot boots is the FALLBACK_KERNEL in the root's
# /etc/rtpi/device.env.
#
# Idempotent: the release's module tree is replaced, and everything else is a copy.

set -euo pipefail
die() { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
log() { printf '\033[1;34m==>\033[0m %s\n' "$*" >&2; }
ok()  { printf '\033[1;32m[✓]\033[0m %s\n' "$*" >&2; }

ART=""; ROOT=/; DRACUT=1
while [[ $# -gt 0 ]]; do
  case $1 in
    --artefacts) ART=$2; shift 2 ;;
    --root)      ROOT=$2; shift 2 ;;
    --no-dracut) DRACUT=0; shift ;;
    -h|--help)   sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown argument: $1 (--artefacts DIR [--root DIR] [--no-dracut])" ;;
  esac
done
[[ -n $ART ]] || die "no --artefacts DIR"
ART=${ART%/}; ROOT=${ROOT%/}; [[ -n $ROOT ]] || ROOT=/
[[ -d $ART ]] || die "no such artefacts directory: $ART"

REL=$(cat "$ART/kernelrelease" 2>/dev/null) || die "$ART has no kernelrelease — run make vip-rt"
[[ -n $REL ]] || die "$ART/kernelrelease is empty"
KIND=$(cat "$ART/build-kind" 2>/dev/null || echo full)
for f in "boot-$REL.tar.gz" "modules-$REL.tar.gz"; do
  [[ -s "$ART/$f" ]] || die "$ART/$f is missing or empty — did the build finish?"
done

ENVFILE="$ROOT/etc/rtpi/device.env"
[[ -f $ENVFILE ]] || die "$ENVFILE is missing: it names FALLBACK_KERNEL"
FALLBACK=$(sed -n 's/^FALLBACK_KERNEL=//p' "$ENVFILE" | tail -1)
[[ -n $FALLBACK ]] || die "$ENVFILE has no FALLBACK_KERNEL"
[[ $FALLBACK != "$REL" ]] || die "the fallback release is the pedal's own ($REL)"
log "installing $REL ($KIND) into $ROOT, beside the stock $FALLBACK"

W=$(mktemp -d); trap 'rm -rf "$W"' EXIT

# The artefacts are checked before anything is written, not after: a half-installed kernel is
# worse than none.
if [[ -s $ART/sha256sums ]]; then
  ( cd "$ART" && sha256sum -c --quiet sha256sums ) || die "$ART/sha256sums does not match the artefacts"
  ok "artefact checksums verified"
fi

# ------------------------------------------------------------------ modules
rm -rf "$ROOT/lib/modules/$REL"
mkdir -p "$ROOT/lib/modules/$REL"
tar -C "$ROOT" -xzf "$ART/modules-$REL.tar.gz"
[[ -s "$ROOT/lib/modules/$REL/modules.dep" ]] \
  || die "no modules.dep after unpacking — modules_install did not finish"
ok "modules: $(find "$ROOT/lib/modules/$REL" -name '*.ko' | wc -l) .ko files"

# The module-set gate. A full build must carry exactly the stock kernel's modules; a trimmed build
# is deliberately a subset, so its invariant is what the board actually loads (proc-modules, taken
# on the board when the kernel was built) plus the recorded removals in trimmed-ok.txt.
if [[ $KIND == full ]]; then
  comm -13 \
    <(find "$ROOT/lib/modules/$REL/kernel" -name '*.ko' -printf '%f\n' | sed 's/\.ko$//' | sort -u) \
    <(find "$ROOT/lib/modules/$FALLBACK/kernel" -name '*.ko*' -printf '%f\n' | sed 's/\.ko.*//' | sort -u) \
    > "$W/missing-modules.txt" || true
  if [[ -s $W/missing-modules.txt ]]; then
    printf '!!! these stock modules are missing from the new tree:\n' >&2
    cat "$W/missing-modules.txt" >&2
    rm -rf "$ROOT/lib/modules/$REL"
    exit 1
  fi
  ok "module set matches the stock kernel's"
else
  [[ -s $ART/proc-modules ]] || die "$ART/proc-modules is missing: the trimmed build's gate needs it"
  # On a running root, say so if it has moved on from the list the build was made against: the
  # gate below can only speak for the modules that were loaded then.
  if [[ -r /proc/modules && $ROOT == / ]]; then
    moved=$(comm -13 <(awk '{print $1}' "$ART/proc-modules" | sort -u) \
                     <(awk '{print $1}' /proc/modules | sort -u) | tr '\n' ' ')
    [[ -z ${moved// /} ]] || printf '\033[1;33m[!]\033[0m modules loaded now that the build did not see: %s\n' "$moved" >&2
  fi
  awk '{print $1}' "$ART/proc-modules" | sort -u > "$W/loaded-modules.txt"
  { find "$ROOT/lib/modules/$REL/kernel" -name '*.ko' -printf '%f\n' | sed 's/\.ko$//' | tr '-' '_'
    sed 's|.*/||; s/\.ko$//' "$ROOT/lib/modules/$REL/modules.builtin" 2>/dev/null | tr '-' '_'
  } | sort -u > "$W/have-modules.txt"
  comm -23 "$W/loaded-modules.txt" "$W/have-modules.txt" > "$W/missing-modules.txt" || true
  if [[ -s $ART/trimmed-ok.txt ]]; then
    tr ' ' '\n' < "$ART/trimmed-ok.txt" | sed '/^[[:space:]]*$/d' | sort -u > "$W/ok.txt"
    expected=$(comm -12 "$W/missing-modules.txt" "$W/ok.txt" || true)
    [[ -z ${expected// /} ]] || log "recorded removals, expected absent: $(echo $expected)"
    comm -23 "$W/missing-modules.txt" "$W/ok.txt" > "$W/missing2.txt" || true
    mv "$W/missing2.txt" "$W/missing-modules.txt"
  fi
  if [[ -s $W/missing-modules.txt ]]; then
    printf '!!! these modules the board loads are missing from the trimmed tree:\n' >&2
    cat "$W/missing-modules.txt" >&2
    rm -rf "$ROOT/lib/modules/$REL"
    exit 1
  fi
  ok "trimmed tree covers every module the board loads"
fi

# ------------------------------------------------------------------ /boot
mkdir -p "$W/boot"
tar -C "$W" -xzf "$ART/boot-$REL.tar.gz"
install -m 644 "$W/boot/vmlinuz" "$ROOT/boot/vmlinuz-$REL"
install -m 644 "$W/boot/config-$REL" "$ROOT/boot/config-$REL"
install -m 644 "$W/boot/System.map-$REL" "$ROOT/boot/System.map-$REL"

# Device trees: the overlays this tree builds are byte-identical to the stock package's (checked
# when the rebuild was introduced), so they come from the stock release's directory; the built
# bcm2712* dtbs are checked against the stock ones before either is trusted.
rm -rf "$ROOT/usr/lib/firmware/$REL"
mkdir -p "$ROOT/usr/lib/firmware/$REL"
cp -a "$ROOT/usr/lib/firmware/$FALLBACK/device-tree" "$ROOT/usr/lib/firmware/$REL/device-tree"
stock_sha=$(sha256sum "$ROOT/usr/lib/firmware/$FALLBACK/device-tree/broadcom/bcm2712-rpi-5-b.dtb" | cut -d' ' -f1)
built_sha=$(cut -d' ' -f1 "$ART/bcm2712-rpi-5-b.dtb.sha256" 2>/dev/null || true)
if [[ -n $built_sha && $stock_sha == "$built_sha" ]]; then
  ok "built bcm2712-rpi-5-b.dtb is byte-identical to the stock one ($built_sha)"
elif [[ -n $built_sha ]]; then
  printf '\033[1;33m[!]\033[0m built bcm2712-rpi-5-b.dtb differs from stock (%s vs %s) — keeping the stock dtbs\n' \
    "$built_sha" "$stock_sha" >&2
fi
cp "$W/dtb/"*.dtb "$ROOT/usr/lib/firmware/$REL/device-tree/broadcom/"

# ------------------------------------------------------------------ the guarded initramfs
if (( DRACUT )); then
  chroot "$ROOT" dracut --quiet --force --reproducible --no-hostonly --kver "$REL" \
    --add-drivers "sdhci-brcmstb sdhci-iproc mmc_block ext4 vfat" "/boot/initrd.img-$REL"
  chroot "$ROOT" lsinitrd "/boot/initrd.img-$REL" > "$W/initrd-list.txt"
  grep -q 'vip-guard\.sh' "$W/initrd-list.txt" \
    || die "vip-guard.sh is not in the new initramfs — it would not count boots"
  ok "initramfs: $(du -h "$ROOT/boot/initrd.img-$REL" | cut -f1), vip-guard.sh inside"
fi

ok "installed $REL in $ROOT: $(du -sh "$ROOT/lib/modules/$REL" | cut -f1) of modules, vmlinuz and initrd in $ROOT/boot (the stock $FALLBACK is untouched)"
