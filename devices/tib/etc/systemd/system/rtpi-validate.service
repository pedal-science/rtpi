[Unit]
Description=rtpi: validate a candidate kernel boot, reboot to known-good if unreachable
Documentation=https://github.com/rikkus/rtpi

# The service does not exist at all on a known-good boot. systemd matches this against
# /proc/cmdline, where our boot.cmd writes rtpi.slot=candidate only when the one-shot has
# actually selected the candidate slot. A reboot loop on the known-good slot would be far
# worse than the lockout this prevents, so the condition is the primary guard and the
# script re-checks it independently.
ConditionKernelCommandLine=rtpi.slot=candidate

# Ordering only, not a hard dependency. Requiring network-online.target would be the wrong
# shape: on the failure this exists to catch, that target never comes up, and we would be
# waiting on the very thing we are supposed to be detecting the absence of. The script does
# its own polling with its own deadline instead.
After=network.target ssh.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rtpi-validate

# Comfortably longer than the script's own 300s deadline plus its reboot escalation, so
# systemd never kills it mid-decision. The script is what enforces timing.
TimeoutStartSec=600

# To the console as well as the journal: if the network is down, HDMI is how you read this,
# and the journal is on a zram disk that will not survive the reboot we may be about to do.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
