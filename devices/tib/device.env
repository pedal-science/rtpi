# tib — ASUS Tinker Board S (Rockchip RK3288), Armbian on Ubuntu 26.04 resolute, armhf
# Sourced by scripts. Keep this the single source of truth for device facts.

DEVICE_NAME=tib
SSH_HOST=tib
# The hostname resolves to tib's WLAN address (192.168.178.4 via fritz.box), so a plain
# `ssh tib` reaches the board over wifi only. The dwmac-rk rewrite in 7.1/7.2 is the main
# regression risk for ethernet, so the tooling must be able to use either path.
#
# CURRENTLY UNUSABLE AS A SECOND PATH, as of 2026-09-15 19:11.
# end0 was 192.168.178.171 (leased from the Fritz!Box at 192.168.178.2) and was verified
# reachable from the Mac. After the card-swap reboot it came up as 192.168.188.24, leased
# from 192.168.188.1 -- AVM's fallback address, i.e. a FRITZ! repeater/powerline that is
# routing and NATing rather than bridging. tib reaches the internet through it fine, but
# NAT means the Mac cannot reach tib inbound on that address, so it is worthless as a
# recovery route. Until the ethernet is moved to a bridged port on the main LAN (or that
# device is switched to bridge/AP mode), wlan0 is the ONLY path and the second-path
# argument for tolerating the dwmac-rk risk does not hold.
#
# Re-check after any change with: ssh tib 'ip -br addr'
# When end0 is back on 192.168.178.x, set it here (space-separated list, tried in order).
SSH_HOST_ALT=""
ARCH=arm
DEB_ARCH=armhf
CROSS_COMPILE=arm-linux-gnueabihf-

BOARD_MODEL="ASUS Tinker Board S"
BOOT_SOC=rk3288
BOARD_DTB=rk3288-tinker-s.dtb

# RK3288 is Cortex-A17, ARMv7 only. There is no 64-bit option for this board, ever.
CPU_ARCH=armv7l

# Armbian branch. 'current' is 6.18 (no ARM32 PREEMPT_RT); 'edge' is 7.2 tracking
# kernel.org stable branch:linux-7.2.y, whose HEAD is >= 7.2.6.
# ARM32 PREEMPT_RT landed in v7.1 (commit c6e61c06d606). The three follow-up fixes
# (9483/1, 9484/1, 9485/1) landed in stable v7.2.6 — verified by bisecting stable tags:
# HAVE_POSIX_CPU_TIMERS_TASK_WORK is absent in v7.2..v7.2.5 and present in v7.2.6.
# So NO cherry-picks are required. patches/ is empty for this device by design.
ARMBIAN_BRANCH=edge
KERNEL_MIN_VERSION=7.2.6
ARMBIAN_PATCH_DIR=patch/kernel/archive/rockchip-7.2
ARMBIAN_CONFIG=config/kernel/linux-rockchip-edge.config

# The kernel frozen in the -good slot, i.e. what the board boots by default and what every
# failure falls back to. Since 2026-09-16 that is our own RT build, not Armbian's.
STOCK_KERNEL=7.2.6
KNOWN_GOOD_KERNEL=7.2.6

# Armbian's kernel remains fully installed (/boot/vmlinuz-6.18.44-current-rockchip and
# /lib/modules/6.18.44-current-rockchip) as a deeper fallback. If 7.2.6 ever proves bad in
# a way the A/B rig cannot catch, re-freeze it:
#   ssh tib 'sudo ln -sfn vmlinuz-6.18.44-current-rockchip /boot/zImage \
#            && sudo ln -sfn uInitrd-6.18.44-current-rockchip /boot/uInitrd \
#            && sudo ln -sfn dtb-6.18.44-current-rockchip /boot/dtb'
#   scripts/deploy/tib-freeze-good.sh --force
ARMBIAN_FALLBACK_KERNEL=6.18.44-current-rockchip
STOCK_KERNEL_PKG=linux-image-current-rockchip

# Boot: U-Boot reads /boot/boot.scr, built from /boot/boot.cmd.
BOOT_DIR=/boot
BOOT_SCRIPT_SRC=/boot/boot.cmd
BOOT_SCRIPT_BIN=/boot/boot.scr
BOOT_ENV_FILE=/boot/armbianEnv.txt
KERNEL_IMAGE_TYPE=zImage
INITRD_ARCH=arm

# Frozen known-good slot the one-shot falls back to. Every failure path lands here.
GOOD_SLOT_SUFFIX=-good

# U-Boot environment. Confirmed against the board's own U-Boot config, shipped at
# /usr/lib/u-boot/tinker-s-rk3288_defconfig by linux-u-boot-tinkerboard-current:
#   CONFIG_ENV_IS_IN_MMC=y  CONFIG_ENV_MMC_DEVICE_INDEX=1
#   CONFIG_ENV_OFFSET=0x3f8000  CONFIG_ENV_SIZE=0x8000  CONFIG_CMD_SAVEENV=y
# DEVICE_INDEX=1 means saveenv writes to U-Boot mmc1, which is this SD card (the
# rk3288-u-boot.dtsi aliases are mmc0=&emmc, mmc1=&sdmmc; corroborated by the built-in
# boot_targets="mmc1 mmc0 ..."). So saveenv and fw_setenv target the same 32KB region.
# 0x3f8000 = LBA 8128, 64 blocks, ending exactly at partition 1's start (sector 8192).
#
# The region is currently all zeros (never saved). It is bootstrapped WITHOUT a serial
# console by rtpi region 1 of boot.cmd, which runs saveenv from inside U-Boot on the
# first boot that finds rt_try undefined; saveenv persists the COMPLETE in-memory env.
# Always confirm with decode-uboot-env.py before any fw_setenv.
UBOOT_ENV_DEV=/dev/mmcblk0
UBOOT_ENV_OFFSET=0x3F8000
UBOOT_ENV_SIZE=0x8000
UBOOT_ENV_LBA=8128
UBOOT_ENV_BLOCKS=64
# fw_printenv/fw_setenv come from libubootenv-tool, NOT u-boot-tools.
UBOOT_ENV_PKG=libubootenv-tool
# The one-shot flag consumed and cleared by our custom boot.cmd.
TRY_VAR=rt_try

# dw_wdt at ff800000. Measured pclk_wdt 24.75MHz => max timeout 86.7s, min ~1.35s.
# Armbian already arms systemd's watchdog at 30s, which is within range.
WATCHDOG_MAX_SEC=86
WATCHDOG_RUNTIME_SEC=30

PANIC_ARGS="panic=10"

AUDIO_CARD_NAME="Generic USB Audio"
AUDIO_USB_ID=0bda:49f6

# The real regression risk moving 6.18 -> 7.2 is dwmac-rk.c, rewritten wholesale across
# 7.1/7.2 (rk3288_ops is now a 13-line struct). The DT is byte-identical between
# v6.18.52 and v7.2.6, so ethernet is the thing to validate, not the device tree.
# wlan0 is an independent second path — accept either.
NET_IFACES="end0 eth0 wlan0"
NET_REQUIRE=any

# NO eMMC on this board: mmc@ff0f0000 (the eMMC controller) is enabled but reports no
# card, and mmc@ff0e0000 is disabled. lsblk shows only mmcblk0 (SD, 7.4G). The idbloader
# is at sector 64 of mmcblk0 and the env at LBA 8128, both before partition 1 (sector
# 8192) — so writing a fresh image to the SD replaces bootloader, env and rootfs together,
# with nothing on eMMC able to override it. A spare SD is therefore a complete recovery.
SD_IS_SOLE_BOOT_MEDIA=yes
SPARE_SD_IS_FULL_RECOVERY=yes

# Out-of-band console WITHOUT a cable: U-Boot is built with CONFIG_VIDEO=y,
# CONFIG_VIDEO_DW_HDMI=y, CONFIG_USB_KEYBOARD=y, CONFIG_CONSOLE_MUX=y, and its built-in
# env is stdout=serial,vidconsole / stdin=serial,usbkbd. A monitor plus a USB keyboard
# gives a fully interactive U-Boot prompt. Serial remains the only way to see the earliest
# SPL output (before video init) or to read a failure remotely from the Mac.
UBOOT_HAS_VIDEO_CONSOLE=yes
UBOOT_HAS_USB_KEYBOARD=yes
SERIAL_REQUIRED=no

# Kernel has CONFIG_PSTORE_RAM=y and CONFIG_PSTORE_CONSOLE=y, so a reserved ramoops region
# would preserve the kernel log across the watchdog reset for reading on the fallback
# boot. Not configured yet.
PSTORE_RAM_AVAILABLE=yes

# Serial console: ttyS2 is on header pins 32/33 (GPIO7_C6/C7), GND pin 34.
# NOT pins 8/10 — those are UART1. Optional, per SERIAL_REQUIRED above.
SERIAL_CONSOLE=ttyS2
SERIAL_BAUD=115200
SERIAL_PINS="TX=32 RX=33 GND=34"

# Only 5.5G free and 2GB RAM: this board cannot build its own kernel. Always cross-build.
BUILD_NATIVE=no
