#!/usr/bin/env bash
# rtpi: decide whether a candidate kernel boot is usable, and reboot if it is not.
#
# THE FAILURE THIS EXISTS TO PREVENT
# tib's one-shot clears its flag BEFORE the candidate runs, so any reboot returns to the
# frozen known-good slot. That covers a candidate that hangs or panics -- the watchdog or a
# power cycle ends it. It does NOT cover a candidate that boots perfectly and comes up with
# no working network: systemd is healthy, so it pets the watchdog quite happily, nothing
# triggers a reboot, and the board sits there running an untested kernel, unreachable,
# until somebody walks over to it.
#
# That is the exact lockout piv's validate hook exists to prevent, and it matters more on
# tib now that the ethernet cable is out and wlan0 is the only path. Moving 6.18 -> 7.2
# carries real risk for rtw88_8723ds, an SDIO driver, and if it breaks there is no second
# route in.
#
# WHAT IT DOES NOT DO
# It does not promote anything. A candidate that passes stays the candidate, and the next
# reboot still returns to known-good -- that is what "one-shot" means. Promotion is a
# deliberate act: freeze the new kernel into the -good slot with tib-freeze-good.sh once
# you actually trust it.
#
# Dormant unless the kernel command line says rtpi.slot=candidate. The unit file gates on
# that too; this is the belt to its braces, because a reboot loop on the known-good slot
# would be far worse than the problem being solved.

set -uo pipefail

DEADLINE_SEC="${RTPI_VALIDATE_DEADLINE:-300}"
STATE_DIR=/var/lib/rtpi
LOG="$STATE_DIR/validate.log"

mkdir -p "$STATE_DIR"

say() {
  # To the journal, the console (so it lands on HDMI if a screen is attached), and a file
  # on the ROOT filesystem. Not /var/log -- that is a zram disk on this board and does not
  # survive the reboot we may be about to cause, which would destroy the only evidence of
  # why we caused it.
  local msg="$(date -u +%Y-%m-%dT%H:%M:%SZ) rtpi-validate: $*"
  echo "$msg" >> "$LOG"
  echo "$msg"
}

slot=$(grep -o 'rtpi\.slot=[a-z-]*' /proc/cmdline | head -1 | cut -d= -f2)
if [[ ${slot:-} != candidate ]]; then
  say "slot is '${slot:-unknown}', not a candidate boot — nothing to do"
  exit 0
fi

say "=== candidate boot: $(uname -r) ==="
say "banner: $(uname -v)"
if uname -v | grep -q PREEMPT_RT; then say "realtime: YES (PREEMPT_RT)"; else say "realtime: no"; fi

# --- the checks --------------------------------------------------------------------
# Deliberately only two, and both are about REACHABILITY. The question this service
# answers is "can a human still get in to fix this?", not "is the kernel any good". A
# candidate with terrible latency or a dead sound card is a bad kernel we can investigate
# at leisure over ssh; a candidate with no network is one we cannot.

have_address() {
  # Any interface except loopback carrying a global-scope IPv4. NOT a named interface:
  # writing this against eth0 is precisely the mistake that would have rolled back every
  # good kernel on piv, whose eth0 is permanently NO-CARRIER.
  ip -4 -o addr show scope global 2>/dev/null | grep -qv ' lo '
}

sshd_listening() {
  ss -ltn 2>/dev/null | grep -qE ':22[[:space:]]'
}

# --- rehearsal hook -----------------------------------------------------------------
# Unlike piv, tib's two slots share one root filesystem -- only the kernel, initrd and dtb
# differ. So there is no way to break networking for the candidate alone in order to
# rehearse the failure path: any change would break the known-good slot too. This flag is
# the honest substitute.
#
# It is consumed on read, before anything else happens. If it were left in place and the
# reboot landed on a candidate again, it would fail that boot too and loop.
REHEARSE=0
if [[ -e $STATE_DIR/force-validate-failure ]]; then
  rm -f "$STATE_DIR/force-validate-failure"
  sync
  REHEARSE=1
  say "REHEARSAL: force-validate-failure flag found and consumed."
  say "REHEARSAL: pretending the checks failed. The network is fine; this is a drill."
fi

deadline=$(( $(date +%s) + DEADLINE_SEC ))
ok_net=0
ok_ssh=0

while [[ $(date +%s) -lt $deadline ]] && (( ! REHEARSE )); do
  (( ok_net )) || { have_address    && { ok_net=1; say "network: $(ip -4 -o addr show scope global | grep -v ' lo ' | awk '{print $2" "$4}' | tr '\n' ' ')"; }; }
  (( ok_ssh )) || { sshd_listening  && { ok_ssh=1; say "sshd: listening on 22"; }; }
  (( ok_net && ok_ssh )) && break
  sleep 3
done

if (( ok_net && ok_ssh )); then
  say "PASS — reachable. Leaving the candidate running."
  say "NOTE: this is still a one-shot. The next reboot returns to the known-good slot."
  say "      To keep this kernel, freeze it: scripts/deploy/tib-freeze-good.sh"
  exit 0
fi

# --- failure: get back to a kernel we can reach -------------------------------------
if (( REHEARSE )); then
  say "FAIL (REHEARSAL) — simulating an unreachable candidate"
else
  say "FAIL after ${DEADLINE_SEC}s — network=$ok_net sshd=$ok_ssh"
fi
say "diagnostics follow, then rebooting to the known-good slot"
# Capture generously. This log is the ONLY evidence that will survive the reboot, and on a
# candidate with no network there is no second chance to go and look. The first version of
# this grepped dmesg for driver names and captured nothing at all -- which told us the
# wifi was down and absolutely nothing about why.
{
  echo "--- ip addr ---";       ip -br addr 2>&1
  echo "--- links ---";         ip -br link 2>&1
  echo "--- listening ---";     ss -ltn 2>&1 | head -20
  echo "--- wifi phy ---";      ls -la /sys/class/ieee80211/ 2>&1
  echo "--- mmc hosts ---";     for h in /sys/class/mmc_host/*; do
                                  [ -e "$h" ] || continue
                                  echo "$(basename "$h"): cards=$(ls -d "$h"/mmc* 2>/dev/null | tr '\n' ' ')"
                                done
  echo "--- rtw88 modules loaded ---"; lsmod 2>&1 | grep -iE 'rtw|mac80211|cfg80211' || echo "(none loaded)"
  echo "--- modprobe rtw88_8723ds ---"; modprobe -v rtw88_8723ds 2>&1 | tail -10
  echo "--- firmware present ---"; ls -la /lib/firmware/rtw88/ 2>&1 | head -10
  echo "--- networkd ---";      journalctl -b -u systemd-networkd --no-pager 2>&1 | tail -20
  echo "--- wpa_supplicant ---"; journalctl -b -u 'wpa_supplicant*' --no-pager 2>&1 | tail -20
  # EARLY boot first. SDIO and network drivers probe in the first few seconds, so on a
  # 300-second validation run "tail" captures the least interesting part of the log. The
  # first version of this took tail -120 and recorded nothing about why the wifi was
  # missing, which is the one question the log exists to answer.
  echo "--- dmesg: EARLY boot (first 250 lines) ---"; dmesg 2>&1 | head -250
  echo "--- dmesg: mmc/sdio/wifi lines, wherever they are ---"
  dmesg 2>&1 | grep -inE 'mmc|sdio|rtw|wlan|pwrseq|dw_mmc|dwmmc' || echo "(no matching lines at all)"
  echo "--- dmesg tail ---"; dmesg 2>&1 | tail -60
} >> "$LOG" 2>&1
sync

say "rebooting now"
systemctl reboot

# If systemd cannot complete a clean reboot -- plausible on a kernel broken enough to have
# got us here -- escalate rather than sit in a half-shut-down state forever.
sleep 30
say "clean reboot did not take effect; forcing"
systemctl reboot --force 2>/dev/null || reboot -f 2>/dev/null
sleep 15
say "forcing via sysrq"
sync
echo b > /proc/sysrq-trigger 2>/dev/null
exit 1
