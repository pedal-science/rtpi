# pro — HP ProDesk 600 G5 Mini (i5-9500T, 6 cores, no SMT), Ubuntu 26.04 resolute, x86-64
# Sourced by scripts. Keep this the single source of truth for device facts.
#
# pro is the pedal's second Core host, for the bigger case; vip (Raspberry Pi 5) is the first.
# pedal.project/docs/pro.md says why it exists and what it is. This file and devices/pro/ are its
# kernel and its boot, as devices/vip/ is vip's — everything above the kernel is pedal.project's
# devices/pro/.

DEVICE_NAME=pro
SSH_HOST=pro
ARCH=amd64
DEB_ARCH=amd64

# Board identity. There is no device tree: x86 has DMI.
BOARD_MODEL="HP ProDesk 600 G5 Desktop Mini"

# ---------------------------------------------------------------- kernels
# pro takes Ubuntu's own amd64 PREEMPT_RT flavour, from the normal archive, and does NOT rebuild it.
# Three reasons, in order of how much they settle the question:
#
#   1. SECURE BOOT IS ENABLED on this machine (`mokutil --sb-state`), with Canonical's shim and a
#      signed GRUB. `linux-image-7.0.0-38-realtime` is a *signed* image (source package
#      linux-signed-realtime). A kernel built the way vip's is would not load at all without
#      enrolling a Machine Owner Key, which is a bigger change to the machine's trust than the
#      pedal needs, and one the owner would have to type a password into at the next boot.
#   2. There is nothing to change. rtpi's config/audio-rt-common.fragment lists what a low-latency
#      kernel needs; every RT-relevant symbol in it (PREEMPT_RT, HZ_1000, NO_HZ_FULL, RCU_NOCB_CPU,
#      RT_GROUP_SCHED=n, the osnoise/timerlat/hwlat tracers) is already set in Ubuntu's flavour.
#      vip's rebuild exists for CONFIG_NUMA_EMU, which the Pi firmware's `numa=fake=4` needs, and
#      for an RP1 DMA patch — a Pi I/O chip pro does not have.
#   3. It is in main and not gated behind Ubuntu Pro ("This machine is not attached to an Ubuntu Pro
#      subscription" and apt-cache policy still offers it), so it updates like any other package.
#      This is the same route piv takes with linux-raspi-realtime.
#
# The flavour lags generic (38 against 42) because it is a separate source package. That is not a
# problem: it is held (scripts/safety/hold-packages.sh), so it moves when we move it.
#
# NOTE the version here is the ABI, not the package version: `uname -r` says 7.0.0-38-realtime while
# the package is 7.0.0-38.38.1. Bump both when the kernel moves.
PEDAL_KERNEL=7.0.0-38-realtime
RT_APT_PKG=linux-image-7.0.0-38-realtime
RT_APT_MODULES=linux-modules-7.0.0-38-realtime
# turbostat and perf, which are built per kernel version: `linux-tools-common` alone installs a
# wrapper that says "turbostat not found for kernel 7.0.0-38" and exits. Installed with the kernel
# rather than listed in pedal.project's devices/pro/packages, because it is pinned to the kernel's
# ABI and has to move when that does. turbostat is how the SMI count is read, which is the one
# candidate for the stall that failed pro's first hour-long soak that nothing else would show.
RT_APT_TOOLS=linux-tools-7.0.0-38-realtime
# `linux-realtime`, the meta package, RECOMMENDS thermald — a daemon that moves the CPU's frequency
# and power limits to hold a temperature, which is exactly the jitter pedal-tune's performance
# governor exists to remove. So the versioned packages are installed by name, with
# --no-install-recommends, and thermald is masked in pedal.project's devices/pro/rootfs/etc/pedal/
# masked-units in case it arrives some other way.
RT_APT_RECOMMENDS=no

# The kernel that must remain installed as the fallback: Ubuntu's stock generic, which is what pro
# ran before any of this and what its own boot entries still point at. Nothing here ever removes it.
FALLBACK_KERNEL=7.0.0-42-generic
STOCK_KERNEL=7.0.0-42-generic
STOCK_KERNEL_PKG=linux-image-7.0.0-42-generic

# ---------------------------------------------------------------- boot layout
# GRUB on UEFI, not the Pi bootloader, so there are no A/B slots to manage: GRUB already has a
# one-shot boot (`grub-reboot`, which writes next_entry into grubenv and clears it before loading
# the kernel), and that is the whole mechanism vip's two FAT slots exist to provide. What pro-boot
# adds is the policy around it — write the entries, try one once, validate it, promote or fall back.
#
# grubenv is writable here because /boot is its own ext4 partition: on an LVM or RAID /boot, GRUB
# cannot write and `grub-reboot` silently does nothing. scripts/safety/preflight.sh checks it.
BOOT_TOOL=pro-boot
BOOT_MOUNT=/boot
ESP_MOUNT=/boot/efi
GRUBENV=/boot/grub/grubenv
# The entry ids pro-boot's /etc/grub.d/42_pedal writes. Ubuntu's own entries keep theirs
# (gnulinux-simple-<uuid>), which is the one pro falls back to and the one `pro-boot default stock`
# returns to.
ENTRY_TUNED=pedal-tuned
ENTRY_LOOSE=pedal-loose
ENTRY_TRIAL=pedal-trial
# A half-written entry is worse than none, and update-grub rewrites grub.cfg in place.
BOOT_MIN_FREE_MB=200

# ---------------------------------------------------------------- command line
# `ro` and nothing else. Deliberately absent, and why:
#   net.ifnames=0   vip uses it so its units can say `wlan0`. Here it would rename wlp0s20f3, the
#                   interface that carries ssh and the only way in. Not worth a tidier name.
#   console=        pro is headless with no serial console wired; the firmware's default is right.
#   crashkernel=    Ubuntu's own entries carry it for kdump-tools, which reserves 512 MB on this
#                   machine and loads a second kernel at boot. kdump is masked on the pedal, so the
#                   pedal's entries do not pay for it. Ubuntu's entries keep it, untouched.
BASE_ARGS="ro"

# Root is on LVM behind dracut. All four of these are needed, and none is sufficient alone: the
# failure they cover is "the root device never appears", which otherwise waits forever in an
# initramfs shell nobody can reach.
DRACUT_SAFETY_ARGS="rd.shell=0 rd.emergency=reboot rd.retry=60 rd.timeout=90"
PANIC_ARGS="panic=10"

# The low-latency profile's kernel arguments. Applied to a TRIAL entry first, so a set that does not
# come back falls back exactly as a bad kernel does — a boot line that loses the machine is as
# effective a way to lose it as a broken kernel, and deserves the same one-shot treatment.
#
# The runtime half is pedal.project's devices/pro/rootfs/etc/pedal/tune.conf, and the two must agree
# about which cores are reserved; pedal-tune checks them against each other at boot.
#
# Why each of these, on six cores with the interface on USB:
#   isolcpus=managed_irq,domain,1-5
#       Reserve cores 1-5 — all but one. 'domain' takes them out of scheduler load balancing so
#       nothing drifts onto them; 'managed_irq' keeps driver-steered (multiqueue) interrupts off
#       them, which matters a great deal here because the NVMe root spreads six queues across all
#       six cores by default (nvme0q1..q6, one per CPU) and three of those would otherwise land on
#       render cores.
#   nohz_full=1-5
#       Stop the 1000Hz tick on the reserved cores while a single task is running. That tick is
#       otherwise 1000 guaranteed interruptions per second per core.
#   rcu_nocbs=1-5
#       Move RCU callback processing off the reserved cores. Without this nohz_full does not achieve
#       much, because RCU work keeps pulling the tick back on.
#   irqaffinity=0
#       Default every interrupt to the one housekeeping core. This is only the default mask, and
#       only for interrupts allocated after it is parsed — pedal-tune's IRQ_HOUSEKEEPING is what
#       actually moves the ones that came up earlier or asked for a CPU, and on pro that was not
#       academic: the xHCI controller carrying the audio was being delivered to core 5, the active
#       render core, which is the pedal's R4 breaking.
#   skew_tick=1
#       Offset the per-CPU timer ticks from each other. When all cores tick in lockstep they contend
#       for the same locks at the same instant, which shows up as periodic latency spikes rather
#       than as a higher average.
#   drm_kms_helper.poll=0
#       Stop DRM polling the iGPU's connectors. On this machine, with no monitor attached, that poll
#       logs "CPU hog" warnings from output_poll_execute and i915_hpd_poll_init_work — 35 of them in
#       one 45-minute window (pedal.project bench-results/2026-10-31-soak-pro). Nothing here needs
#       display hotplug detection; when rigpa comes to pro it will be with a screen already
#       attached, and this can go.
#
# NOT included, deliberately:
#   mitigations=off   measurably faster, but it is a security decision and not one to make silently
#                     on the owner's behalf. Try it by hand if you want it.
#   nowatchdog, nmi_watchdog=0, nosoftlockup
#                     they would undercut the only automatic detection of a wedged core.
#   tsc=reliable      skips the clocksource watchdog, which is a small, periodic cost — and also the
#                     only thing that would notice this machine's TSC drifting. Measure the cost
#                     before buying it.
#   audit=0           would quieten AppArmor's denials along with the audit subsystem's cost.
#   intel_idle.max_cstate=, processor.max_cstate=
#                     they apply to every core. pedal-tune turns the deep states off on the render
#                     cores only (CPUIDLE_MAX_LATENCY_US), so the housekeeping core still idles.
AUDIO_TUNING_ARGS="isolcpus=managed_irq,domain,1-5 nohz_full=1-5 rcu_nocbs=1-5 irqaffinity=0 skew_tick=1 drm_kms_helper.poll=0"

# The loose profile: the pedal kernel, no isolation, no engine. `pro-boot loose` boots it once and
# `pro-boot default loose` every time. pedal.project's devices/pro/rootfs holds the target.
LOOSE_ARGS="systemd.unit=pedal-maint.target"

# ---------------------------------------------------------------- the watchdog
# OFF by default, unlike vip's, and this is a deliberate difference.
#
# vip is wedged-and-unreachable without one: it has no fallback for a hang, because its tryboot flag
# is one-shot and already consumed, and nobody can power-cycle it remotely. pro is on the bench, in
# the room, and its BIOS says "After Power Loss: Previous State", so a power cycle recovers it.
#
# Against that, the hardware here is less certain: Ubuntu blacklists every watchdog module
# (/lib/modprobe.d/blacklist_linux_*.conf lists iTCO_wdt and wdat_wdt), the BIOS's own "Watchdog
# Timer" setting is Disable, and a watchdog that fires during a deliberate hour-long soak would
# destroy the measurement it fired during — which is rtpi's own warning about vip's.
#
# So: scripts/deploy/harden-pro.sh --watchdog opts in, loading iTCO_wdt explicitly (a blacklist only
# stops automatic loading) and arming systemd. 60 s rather than vip's 14 because nothing here is
# racing the Pi's 15 s hardware maximum, and a long timeout is what makes a spurious reset under
# load implausible.
#
# Worth knowing either way, from this kernel's own log on the first tuned boot:
#     watchdog: Disabling watchdog on nohz_full cores by default
# `nohz_full` turns the kernel's SOFT lockup detector off on cores 1-5, because the detector needs
# the tick it just removed. So on the render cores there is nothing watching for a spinning thread,
# which is one more reason the hardware watchdog is the only thing that would catch one — and one
# more reason not to pretend an unarmed one is covering it.
WATCHDOG=off
WATCHDOG_MODULE=iTCO_wdt
WATCHDOG_RUNTIME_SEC=60

# ---------------------------------------------------------------- audio and network
# The interface under test: a Behringer UMC202HD on USB 2.0. Both buses of the one xHCI controller
# (0000:00:14.0) share a single MSI, so there is exactly one interrupt to place, and
# pedal.project's tune.conf places it (AUDIO_IRQ_MATCH=xhci_hcd, core 1, SCHED_FIFO 85).
AUDIO_CARD_NAME="UMC202HD 192k"
AUDIO_USB_ID=1397:0507

# eno1 has no cable; wlp0s20f3 carries everything. A validate hook that required a particular
# interface would roll back every good kernel, so pro-boot-validate asks for any real one.
NET_IFACES="wlp0s20f3 eno1"
NET_REQUIRE=any
