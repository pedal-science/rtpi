# piv — Raspberry Pi 500 (BCM2712), Ubuntu 26.04 resolute, aarch64
# Sourced by scripts. Keep this the single source of truth for device facts.

DEVICE_NAME=piv
SSH_HOST=piv
ARCH=arm64
DEB_ARCH=arm64

# Board identity. /proc/device-tree/compatible is "raspberrypi,500" + "brcm,bcm2712".
BOARD_MODEL="Raspberry Pi 500"
BOARD_DTB=bcm2712-rpi-500.dtb
# flash-kernel's db says DTB-Id: bcm2712-rpi-5-b.dtb. That is NOT what boots (the firmware
# auto-selects by model) but find_dtb_file() ABORTS if it is missing from a build, so any
# custom kernel must still ship it.
FLASH_KERNEL_DTB_ID=bcm2712-rpi-5-b.dtb

# Boot layout — A/B via piboot-try + the Pi bootloader's one-shot tryboot flag.
BOOT_MOUNT=/boot/firmware
KNOWN_GOOD_SLOT=current
CANDIDATE_SLOT=new
ROLLBACK_SLOT=old

# Stock kernel that must remain installed as the fallback.
STOCK_KERNEL=7.0.0-1017-raspi
STOCK_KERNEL_PKG=linux-image-7.0.0-1017-raspi
# Ubuntu's own Pi-specific RT flavour (same source package, not Pro-gated).
RT_APT_PKG=linux-raspi-realtime
RT_APT_KERNEL=7.0.0-1017-raspi-realtime

# Kernel flavour name is load-bearing: a CUSTOM flavour makes flash-kernel exit 0 having
# written nothing (check_kflavors rejects it). Keep the name, bump only the ABI.
KERNEL_FLAVOUR=raspi-realtime

# Root is on a USB-SATA bridge (ASM1051E). If a candidate kernel fails to enumerate xHCI,
# dracut hangs forever unless ALL of these are set. See README "The dracut lockout".
DRACUT_SAFETY_ARGS="rd.shell=0 rd.emergency=reboot rd.retry=60 rd.timeout=90"
PANIC_ARGS="panic=10"

# BCM2835 watchdog hardware maximum is 15s.
WATCHDOG_MAX_SEC=15
WATCHDOG_RUNTIME_SEC=14

# Audio device under test.
AUDIO_CARD_NAME="SSL 2+ Mk II"
AUDIO_USB_ID=31e9:0009

# Network: eth0 is NO-CARRIER on this box; wlan0 carries everything. A validate hook that
# requires eth0 specifically would roll back every good kernel.
NET_IFACES="wlan0 eth0"
NET_REQUIRE=any

# Boot partition is 505M. At most TWO slots ever coexist (~105M each) + ~22M of firmware
# blobs at the root, so ~232M worst case. Preflight anyway.
BOOT_MIN_FREE_MB=150

# ---------------------------------------------------------------- audio tuning (boot side)
# Kernel command line arguments for the low-latency audio profile. Applied to the
# CANDIDATE slot only, by arm-try-piv.sh --audio-tuning, so a set of arguments that does
# not boot rolls back exactly like a bad kernel does. The runtime half of the profile
# lives in devices/piv/etc/rtpi/audio-tune.conf and the two must agree about which cores
# are reserved.
#
# Why each of these, on a 4-core Cortex-A76 with the interface on USB:
#   isolcpus=managed_irq,domain,1-3
#       Reserve cores 1-3 -- all but one (the amended rules, 2026-10-09: every core but the
#       housekeeping one renders, because the work is rendering). 'domain' takes them out of
#       scheduler load balancing so nothing
#       drifts onto them; 'managed_irq' keeps driver-steered (multiqueue) interrupts off
#       them, which matters here because root is a UAS device that spreads its queues.
#   nohz_full=1-3
#       Stop the 1000Hz tick on the reserved cores while a single task is running. That
#       tick is otherwise 1000 guaranteed interruptions per second per core.
#   rcu_nocbs=1-3
#       Move RCU callback processing off the reserved cores. Without this nohz_full does
#       not achieve much, because RCU work keeps pulling the tick back on.
#   irqaffinity=0
#       Default every interrupt to the one housekeeping core. rtpi-audio-tune then moves the ONE
#       interrupt we care about -- the USB controller carrying audio -- onto core 1, a reserved core
#       that is never the active one (the pedal's D5; RT_CPUS is 3 here, so the audible rig is never
#       on the core the interface interrupts).
#   skew_tick=1
#       Offset the per-CPU timer ticks from each other. When all cores tick in lockstep
#       they contend for the same locks at the same instant, which shows up as periodic
#       latency spikes rather than as a higher average.
#
# NOT included, deliberately:
#   mitigations=off   measurably faster, but it is a security decision and not one to
#                     make silently on the user's behalf. Try it by hand if you want it.
#   nowatchdog        would undercut the safety rig this whole repo is built on.
AUDIO_TUNING_ARGS="isolcpus=managed_irq,domain,1-3 nohz_full=1-3 rcu_nocbs=1-3 irqaffinity=0 skew_tick=1"
