# tib (RK3288, Cortex-A17, ARMv7) — RT deltas on top of audio-rt-common.fragment
#
# Merged with scripts/kconfig/merge_config.sh, so a symbol being turned OFF must be
# written as "# CONFIG_X is not set". "CONFIG_X=n" is silently ignored by the merge,
# which is a good way to believe you disabled something you did not.

# PREEMPT_RT depends on EXPERT && ARCH_SUPPORTS_RT && !COMPILE_TEST. Armbian's config
# already sets EXPERT, but state it so the fragment stands alone.
CONFIG_EXPERT=y

# THE SYMBOL THAT MATTERS MOST, and not for the reason the guides give.
#
# With RT_GROUP_SCHED=y on cgroup v2 with the cpu controller enabled, SCHED_FIFO is
# refused to any task outside the root cgroup -- including root. Measured on this board:
#
#     $ sudo chrt -f 50 true
#     chrt: failed to set pid 0's policy: Operation not permitted
#
# Every systemd service and login session lives in a non-root cgroup, so on the stock
# Armbian kernel JACK and every other realtime audio application is refused a realtime
# priority outright. That is a hard blocker for the whole point of this project, quite
# separate from PREEMPT_RT, and it is why cyclictest needs a root-cgroup escape to run
# at all on the stock kernel.
# CONFIG_RT_GROUP_SCHED is not set

# PREEMPT_RT supersedes these; leaving one set makes the merge ambiguous.
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set

# Stock Armbian runs HZ_250. Both must be cleared or the merge leaves two tick rates set
# and the later one silently wins.
# CONFIG_HZ_250 is not set
# CONFIG_HZ_100 is not set
# CONFIG_HZ_300 is not set

# Costly on every preempt operation and measurable in cyclictest's tail.
# CONFIG_DEBUG_PREEMPT is not set

# HIGHMEM is RT-safe on arm32 (it selects KMAP_LOCAL). The one genuine conflict is
# HIGHPTE, which is "depends on HIGHMEM && !PREEMPT_RT" -- so enabling RT turns it off by
# itself. Stated here only so the next person does not go looking for the problem.
CONFIG_HIGHMEM=y

# NOT set, deliberately: NO_HZ_FULL needs CPUs isolated from the tick to pay for itself,
# and on a 4-core board running a full desktop-ish Armbian userspace there are none to
# spare. NO_HZ_IDLE is the right choice here. Revisit only with isolcpus.
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set
