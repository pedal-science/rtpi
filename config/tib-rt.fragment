# tib (RK3288, Cortex-A17, ARMv7) — RT deltas on top of audio-rt-common.fragment
#
# Merged with scripts/kconfig/merge_config.sh, so a symbol being turned OFF must be
# written as "# CONFIG_X is not set". "CONFIG_X=n" is silently ignored by the merge,
# which is a good way to believe you disabled something you did not.

# PREEMPT_RT depends on EXPERT && ARCH_SUPPORTS_RT && !COMPILE_TEST. Armbian's config
# already sets EXPERT, but state it so the fragment stands alone.
CONFIG_EXPERT=y

# THE SYMBOL THAT MATTERS MOST, and not for the reason the guides give.
#
# With RT_GROUP_SCHED=y on cgroup v2 with the cpu controller enabled, SCHED_FIFO is
# refused to any task outside the root cgroup -- including root. Measured on this board:
#
#     $ sudo chrt -f 50 true
#     chrt: failed to set pid 0's policy: Operation not permitted
#
# Every systemd service and login session lives in a non-root cgroup, so on the stock
# Armbian kernel JACK and every other realtime audio application is refused a realtime
# priority outright. That is a hard blocker for the whole point of this project, quite
# separate from PREEMPT_RT, and it is why cyclictest needs a root-cgroup escape to run
# at all on the stock kernel.
# CONFIG_RT_GROUP_SCHED is not set

# PREEMPT_RT supersedes these; leaving one set makes the merge ambiguous.
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT is not set

# Stock Armbian runs HZ_250. Both must be cleared or the merge leaves two tick rates set
# and the later one silently wins.
# CONFIG_HZ_250 is not set
# CONFIG_HZ_100 is not set
# CONFIG_HZ_300 is not set

# Costly on every preempt operation and measurable in cyclictest's tail.
# CONFIG_DEBUG_PREEMPT is not set

# HIGHMEM is RT-safe on arm32 (it selects KMAP_LOCAL). The one genuine conflict is
# HIGHPTE, which is "depends on HIGHMEM && !PREEMPT_RT" -- so enabling RT turns it off by
# itself. Stated here only so the next person does not go looking for the problem.
CONFIG_HIGHMEM=y

# NO_HZ_FULL, not NO_HZ_IDLE: they are alternatives, not layers. Both are members of
# kernel/time/Kconfig's "Timer tick handling" CHOICE, so setting both -- as this fragment
# used to -- means Kconfig silently keeps one and drops the other. FULL is the one to ask
# for, because it is the superset: it stops the tick on an idle core AND on a busy core
# that is running exactly one task. The note that used to be here said the opposite, and
# measurement has overtaken it (2026-09-17):
#
#   * It is available, not absent. The symbol is offered by Kconfig and was merely disabled, and
#     every prerequisite is already set: CONTEXT_TRACKING, TICK_ONESHOT, HIGH_RES_TIMERS, SMP,
#     NO_HZ_COMMON, HZ=1000. Nothing about the RK3288 blocks it, and it is enabled the same way
#     as on piv: CONFIG_NO_HZ_FULL=y plus nohz_full= on the command line.
#   * It costs 925 timer interrupts per second on the audio core as built -- 554 761 arch_timer
#     interrupts across a 600 s device arm with the engine pinned to cpu 3, against 0/s on the
#     Pi with NO_HZ_FULL in force. cpu2 sits at 40/s because tickless idle already stops the
#     tick on *idle* cores; a busy core is what NO_HZ_FULL adds.
#   * The old reason -- "a 4-core board running a full desktop-ish userspace has none to spare"
#     -- assumes no confinement. The engine is pinned to one core and held there by cgroup v2
#     cpuset confinement, so exactly one core is reserved and three are left. That is a core to
#     spare for the purpose this option exists.
#   * It holds only while the isolated core has exactly one runnable task, so it needs the
#     command line (see devices/tib/boot/boot.cmd) AND the confinement. On the Pi the tick came
#     back without the latter.
#
# Expect little for latency and measure it rather than assume: the quiet device case already
# passes on this board with the tick running (0 xruns, 0 deadline overruns, p99 36.9 %), and
# under a memory load the binding constraint is the shared L2 and 2.98 GB/s of bandwidth, which
# no tick setting touches. This is hygiene for a headless node, not a cure.
CONFIG_NO_HZ_FULL=y
