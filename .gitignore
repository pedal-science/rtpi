# Build artefacts — large, reproducible from sources. Never commit.
# Kernel trees live in a Docker volume, never here.
*.buildinfo
*.changes
*.ddeb
*.deb
*.diff.gz
*.dsc
*.swp
*.tar.gz
*.tar.xz
.DS_Store
/build/
linux-*/
linux/
scratch/
sources/
work/

# Backups pulled from devices. The boot tarballs and whole-card images are hundreds of MB
# or more, so those stay local; the small text artefacts are committed, because they are
# exactly what you want in front of you during a recovery.
devices/*/backups/**/*.img
devices/*/backups/**/*.img.zst
devices/*/backups/**/*.tar
devices/*/backups/**/*.tar.gz

# Raw per-run test output. The assembled results/*.json are committed; the cyclictest JSON
# and histograms behind them are bulky and regenerable.
results/raw/

# Python bytecode from the test suite (tests/vip-boot/ and its loader).
__pycache__/
*.pyc
